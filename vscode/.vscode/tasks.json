{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C++",
            "command": "clang++",
            "args": [
                "-std=c++23",
                "-fsanitize=undefined",
                // "-fdiagnostics-color=always",
                "-g",
                "-DLOCAL",
                "-Iinc",
                // "-Wconversion",
                // "-Wall",
                "-o",
                "${workspaceFolder}/${fileBasenameNoExtension}",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
